@using WebApp_SLM.Models.HorasExtras

@model ViewTiempoExtra

@{
    ViewData["Title"] = "Administrar Horas Extras";
    string formatDate = "dd-MM-yyyy";
}

<style>
    .ui-autocomplete {
        max-height: 120px;
        overflow-y: auto;
        /* prevent horizontal scrollbar */
        overflow-x: hidden;
        z-index: 99999 !important;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card mb-6">
            <h5 class="card-header">Lista de eventos</h5>
            
            <div class="card-body">
                <form asp-controller="TiempoExtra" asp-action="Index">
                    <div class="row g-6" style="margin-top:5px;margin-bottom:16px;">
                        <div class="col-md-6">
                            <label asp-for="myFilterControl.fechaInicioRango" for="dtFechaIni" class="form-label">Fecha Inicio:</label>
                            <input asp-for="myFilterControl.fechaInicioRango" class="form-control" name="fechaInicioRango" type="date" id="fechaInicioRango" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="myFilterControl.fechaFinRango" for="dtFechaFin" class="form-label">Fecha Fin:</label>
                            <input asp-for="myFilterControl.fechaFinRango" class="form-control" name="fechaFinRango" type="date" id="fechaFinRango" />
                        </div>
                        <div class="col mb-6">
                            <label for="txtBuscarPersonal" class="form-label">Personal</label>
                            <div class="input-group mb-3">
                                <span  class="input-group-text" id="basic-addon1"><i class="bi bi-search" ></i></span>
                                <input type="text" class="form-control" id="txtBuscarPersonal">
                            </div>
                        </div>
                        <div class="col mb-6">
                            <input type="hidden" asp-for="myFilterControl.idPersonalFind" id="idPersonalFind" name="idPersonalFind" class="form-control">
                            <input type="hidden" asp-for="myFilterControl.nombreFind" id="nombreFind" name="nombreFind" class="form-control">
                        </div>

                        <div class="col-md-6">
                            <button class="btn btn-primary" >Filtar</button>
                        </div>
                    </div>
                </form>                
                
                
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#backDropModal" onclick="NewOverTime()" asp-action="estadoNew">
                    Nuevo evento
                </button>
                

                
                
            </div>
        </div>
    </div>
</div>
<hr class="my-12">
<div class="card">
    <h5 class="card-header">LISTA DE RESULTADOS</h5>
    <div class="card-subtitle mb-2 mt-2 text-muted">
        <a asp-action="ExportarListaOverTimeFiltro" asp-route-fechaIni="@Model.myFilterControl.fechaInicioRango.ToString(formatDate)"
           asp-route-fechaFin="@Model.myFilterControl.fechaFinRango.ToString(formatDate)"
           asp-route-idPersonalFind="@Model.myFilterControl.idPersonalFind" class="btn btn-link btn-sm">Exportar A Excel</a>

        <a asp-action="DescargarPdfDetallado" asp-route-fechaIni="@Model.myFilterControl.fechaInicioRango.ToString(formatDate)"
           asp-route-fechaFin="@Model.myFilterControl.fechaFinRango.ToString(formatDate)"
           asp-route-idPersonalFind="@Model.myFilterControl.idPersonalFind"
           asp-route-nombrePersonalFind="@Model.myFilterControl.nombreFind" class="btn btn-link btn-sm">Exportar A Pdf (Detallado)</a>

        <a asp-action="DescargarPdfConsolidado" asp-route-fechaIni="@Model.myFilterControl.fechaInicioRango.ToString(formatDate)"
           asp-route-fechaFin="@Model.myFilterControl.fechaFinRango.ToString(formatDate)"
           asp-route-idPersonalFind="@Model.myFilterControl.idPersonalFind"
           asp-route-nombrePersonalFind="@Model.myFilterControl.nombreFind" class="btn btn-link btn-sm">Exportar A Pdf (General)</a>


    </div>
    <div class="table-responsive">
        <table class="table table-hover" id="dataTable">
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>PERSONAL</th>
                    <th>HORARIO</th>
                    <th>H.EXTRA INICIO</th>
                    <th>H.EXTRA FIN</th>
                    <th>HORAS EXTRAS</th>
                    <th>MINUTOS EXTRAS</th>
                    <th>MOTIVO(S)</th>
                    <th>OBSERVACION</th>
                    <th>FECHA INGRESO</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (ListaTiempoExtra d in Model.myListaTiempoExtras)
                {
                <tr>
                    <td style='min-width:100px;'>
                            <div class="row-lg-6">
                                <a class="btn btn-danger btn-sm" asp-action="CrudHoraExtraDelete" asp-route-idOvertime="@d.id" id="btnDelete" onclick="questionDelete(event)"><span class="bi-trash"></span></a>
                                <a class="btn btn-primary btn-sm" onclick="EditOverTime(@d.id)"><span class="bi-pencil-square"></span></a>
                        </div>
                        
                    </td>
                    <td style='min-width:200px;'>@d.nombre_completo </td>
                    <td style='min-width:100px;'>@d.horario_dia </td>
                    <td>@d.dia_hora_inicio</td>
                    <td>@d.dia_hora_fin</td>
                    <td style="text-align:center;">@d.horas_extra</td>
                    <td style="text-align:center;">@d.minutos_extra</td>
                    <td style="min-width:250px;">@d.motivos</td>
                    <td style="min-width:250px;">@d.observacion</td>
                    <td >@d.date_add</td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="backDropModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" asp-action="CrudHoraExtra">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalTitle" >Nuevo Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xl">
                        <div class="card mb-6">
                            <div class="card-body">
                                <div class="col mb-6">
                                    <label for="personal" class="form-label">Buscar Personal</label>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text" id="basic-addon1"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control" id="txtbuscar">
                                    </div>
                                </div>
                                <div class="col mb-6">
                                    <input type="hidden" asp-for="myOverTime.id" id="txtid" class="form-control" id="txtbuscar">
                                    <input type="hidden" asp-for="myOverTime.personal_id" id="txtPersonalId" class="form-control" id="txtbuscar">
                                    <input type="hidden" asp-for="myOverTime.dia_hora_inicio" class="form-control" id="fechaInicio" required />
                                    <input type="hidden" asp-for="myOverTime.dia_hora_fin" class="form-control" id="fechaFin" required />
                                </div>
                                <div class="col mb-6">
                                    <div class="card">
                                        <h6 class="card-header">Personal Seleccionado</h6>
                                        <table class="table table-borderless" id="dataSelected">
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl">
                        <div class="card mb-6">
                            <div class="card-body">
                                <div class="row g-6">
                                    <div class="col mb-0">
                                        <label for="fechaInicioT" class="form-label" >Fecha Inicio</label>
                                        <input class="form-control" type="date" id="FechaInicioT" required />
                                    </div>
                                    <div class="col mb-0">
                                        <label for="HoraInicioT" class="form-label">Hora inicio</label>
                                        <input class="form-control" type="time" id="HoraInicioT" required />
                                    </div>
                                </div>

                                <div class="row g-6" style="margin-top:10px;">
                                    <div class="col mb-0">
                                        <label for="FechaFinT" class="form-label">Fecha Fin</label>
                                        <input class="form-control" type="date" id="FechaFinT" required />
                                    </div>
                                    <div class="col mb-0">
                                        <label for="HoraIFinT" class="form-label">Hora Fin</label>
                                        <input class="form-control" type="time" id="HoraIFinT" required />
                                    </div>
                                </div>

                                <div class="row" style="margin-top:20px;">
                                    <div class="col mb-6">
                                        <label asp-for="myOverTime.motivos" for="sltMotivo" class="form-label">Motivo(s)</label>
                                        <select asp-for="myOverTime.motivos" id="sltMotivo" class="form-select" multiple aria-label="Motivo(s)">
                                        </select>

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col mb-6">
                                        <label asp-for="myOverTime.observacion" class="form-label" for="txtobservacion">Observación</label>
                                        <div class="input-group input-group-merge">
                                            <span id="basic-icon-default-message2" class="input-group-text"><i class="bx bx-comment"></i></span>
                                            <textarea asp-for="myOverTime.observacion" id="txtobservacion" class="form-control" placeholder="Escriba una observación" aria-label="Escriba una observación" aria-describedby="basic-icon-default-message2"></textarea>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" >Cerrar</button>
                <button class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>
<!-- FIN DEL MODAL-->

@section Scripts{    
    <script>
        var esTurnoCru = false;
        var StatusCrud = "NEW";
        const urlListasItemTabla = '@Url.Action("listarItemTablas", "Tablas")?id=4'

        function llenaHorarioPersonal(idPersonal, nombreCompleto, area, puesto){
            let turnoCrusado = ""
            let textoHorario = ""
            const areaPuesto = ((area ? area : "sin área") + " / " + (puesto ? puesto : "sin puesto") )
            $.ajax({
                url: "@Url.Action("ViewHorarioPersonal", "TiempoExtra")?id_personal=" + idPersonal,
                dataType: "json",
                success: function (data) {
                    if (data) {
                        data.forEach(d => {
                            if (d.turnoCrusado == true) {
                                esTurnoCru = true
                            }

                            turnoCrusado = (d.turnoCrusado == true ? " <TC> " : "")
                            textoHorario += d.dia_label + ": " + (d.hora_ingreso).toString().slice(0, 5) + " - " + (d.hora_salida).toString().slice(0, 5) + turnoCrusado + " <i class='text-black-50'>(Refr: " + (d.hora_refr_inicio).toString().slice(0, 5) + "-" + (d.hora_refr_fin).toString().slice(0, 5) + ")</i><br/>"
                        });
                        document.getElementById("dataSelected").querySelector("tbody").innerHTML = "";
                    }

                    if (esTurnoCru == true) {
                        document.getElementById("FechaFinT").setAttribute("disabled", "false")
                    } else {
                        document.getElementById("FechaFinT").setAttribute("disabled", "true")
                    }


                    $("#dataSelected tbody").append(
                        $("<tr>").append(
                            $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Personal</small>"),
                            $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'><b>" + nombreCompleto + "</b></p>")
                        ),
                        $("<tr>").append(
                            $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Área/Puesto</small>"),
                            $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'>" + areaPuesto + "</p>")
                        ),
                        $("<tr>").append(
                            $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Horario</small>"),
                            $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'>" + textoHorario + "</p>")
                        )
                    )
                }
            })
        }

        $(document).ready(function () {

            $("#txtBuscarPersonal").val($("#nombreFind").val());

            $("#txtBuscarPersonal").autocomplete({
                source: function(request, response){
                    $.ajax({
                        url: "@Url.Action("searchPersonal", "TiempoExtra")?texto=" + request.term,
                        dataType: "json",
                        success: function(data){
                            response(data);
                        }
                    })
                },
                minLength: 1,
                select: function (event, ui) {
                    
                    $("#idPersonalFind").val(ui.item.value);
                    $("#nombreFind").val(ui.item.label);
 
                    event.preventDefault();
                    $(this).val(ui.item.label);
                },
                change:function(event, ui){
                  
                    if( ui.item == null){
                        $("#idPersonalFind").val(0);
                        $("#nombreFind").val("");
                        event.preventDefault();
                        $(this).val("");
                    } 
                }

            })

            $("#txtbuscar").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "@Url.Action("searchPersonal", "TiempoExtra")?texto=" + request.term,
                        dataType: "json",
                        success: function (data) {
                            response(data);
                        }
                    })
                },
                minLength: 1,
                select: function (event, ui) {
                    const nombreCompleto = ui.item.label
                    const areaPuesto = ((ui.item.desc_area ? ui.item.desc_area : "sin área") + " / " + (ui.item.desc_puesto ? ui.item.desc_puesto : "sin puesto") )
                    const idPersonal = ui.item.value
                    let turnoCrusado = ""
                    let textoHorario = ""
                    $("#txtPersonalId").val(idPersonal)
                    
                    $.ajax({
                        url: "@Url.Action("ViewHorarioPersonal", "TiempoExtra")?id_personal=" + idPersonal,
                        dataType: "json",
                        success: function (data) {
                            if (data) {
                                data.forEach(d => {
                                    if (d.turnoCrusado == true) {
                                        esTurnoCru = true
                                    }

                                    turnoCrusado = (d.turnoCrusado == true ? " <TC> " : "")
                                    textoHorario += d.dia_label + ": " + (d.hora_ingreso).toString().slice(0, 5) + " - " + (d.hora_salida).toString().slice(0, 5) + turnoCrusado + " <i class='text-black-50'>(Refr: " + (d.hora_refr_inicio).toString().slice(0, 5) + "-" + (d.hora_refr_fin).toString().slice(0, 5) + ")</i><br/>"
                                });
                                document.getElementById("dataSelected").querySelector("tbody").innerHTML = "";
                            }
                            
                            if (esTurnoCru == true) {
                                document.getElementById("FechaFinT").setAttribute("disabled", "false")
                            } else {
                                document.getElementById("FechaFinT").setAttribute("disabled", "true")
                            }
                            
                      
                            $("#dataSelected tbody").append(
                                $("<tr>").append(
                                    $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Personal</small>"),
                                    $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'><b>" + nombreCompleto + "</b></p>")
                                ),
                                $("<tr>").append(
                                    $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Área/Puesto</small>"),
                                    $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'>" + areaPuesto + "</p>")
                                ),
                                $("<tr>").append(
                                    $("<td class='align - middle' width='80px'>").append("<small class='text-black-50 fw-medium'>Horario</small>"),
                                    $("<td class='py-2 align-middle'>").append("<p class='mb-0' style='font-size: small;'>" + textoHorario + "</p>")
                                )
                            )
                        }
                    })
                    event.preventDefault();
                    $(this).val("");
                },
                focus: function (event, ui) {
                    event.preventDefault();
                    $(this).val(ui.item.label);
                }

            })

            $("#sltMotivo").ready(async function () {
                
                const valorTabla = 4;
                const respuesta = await fetch(urlListasItemTabla, {
                    method: "POST",
                    body: valorTabla,
                    headers: {
                        'Content-Type' : 'application/json'
                    }                
                })
                const json = await respuesta.json();
                
                const opciones = json.map(item => `<option value=${item.idSubtabla}>${item.descripcion}</option>`);
                $("#sltMotivo").html(opciones);
            })

            $("#dataTable").ready(async function () {
                //cargarDataEventos();
            })

        })

    </script>    
    <script>
        $("#dtFechaIni").change(async function () {
            //cargarDataEventos();
        })

        $("#dtFechaFin").change(async function () {
            //cargarDataEventos();
        })

        $("#FechaInicioT").change(async function () {
            const valorSelect = $(this).val();
            const horaI = $("#HoraInicioT").val();
            changeTiempo(valorSelect, horaI, "", "", "I");
           
            if (esTurnoCru == false) {
                $("#FechaFinT").val(valorSelect)
            }
        })

        $("#HoraInicioT").change(async function () {
            const valorSelect = $(this).val();
            const fechaI = $("#FechaInicioT").val();
            changeTiempo(fechaI, valorSelect, "", "", "I");
        })

        $("#FechaFinT").change(async function () {
            const valorSelect = $(this).val();
            const horaF = $("#HoraFinT").val();
            changeTiempo("", "", valorSelect, horaF, "F");
        })

        $("#HoraIFinT").change(async function () {
            const valorSelect = $(this).val();
            const fechaF = $("#FechaFinT").val();
            changeTiempo("", "", fechaF, valorSelect, "F");
        })

        function changeTiempo(diaI, horaI, diaF, horaF, origin ) {
            let fi = "";
            let ff = "";
            if (origin == "I") {
                if (diaI && horaI) {
                    fi = diaI.toString() + " " + horaI;
                } else {
                    fi = "";
                }
                $("#fechaInicio").val(fi);
            }            
            if (origin == "F") {
                if (diaF && horaF) {
                    ff = diaF.toString() + " " + horaF;
                } else {
                    ff = "";
                }
                $("#fechaFin").val(ff);
            }
        }

        function questionDelete(e){
            StatusCrud = "DELETE";
            e.preventDefault();
            swal.fire({
                title: "¿Quiere eliminar el registro?",
                icon: "question",
                showCancelButton: true ,
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((resultado) =>{
                if(resultado.isConfirmed){
                    const formulario = document.getElementById("btnDelete");
                    
                    window.location.href = formulario.href;
                    StatusCrud = "NEW";
                }
            })
        }

        function NewOverTime(){
            StatusCrud = "NEW";
            document.getElementById("txtid").value = 0;
            document.getElementById("txtobservacion").value = "";
            document.getElementById("txtPersonalId").value = null;
            document.getElementById("fechaInicio").value = null;
            document.getElementById("fechaFin").value = null;
            document.getElementById("FechaInicioT").value = null;
            document.getElementById("FechaFinT").value = null;
            document.getElementById("HoraInicioT").value = null;
            document.getElementById("HoraIFinT").value = null;

            const miSelect = document.getElementById('sltMotivo');
            for (let i = 0; i < miSelect.options.length; i++) {
                miSelect.options[i].selected = false;
            }
            document.getElementById("ModalTitle").text = "Nuevo Evento";
            tittleModalText= document.getElementById("ModalTitle");
            tittleModalText.textContent="Nuevo Evento";

            document.getElementById("dataSelected").querySelector("tbody").innerHTML = "";
        }

        function EditOverTime( idEdit) {
            StatusCrud = "EDIT";


            const urlSearchOverTime = "@Url.Action("SeachOverTime", "TiempoExtra")?id=" + idEdit;
            $.ajax({
                url: urlSearchOverTime,
                dataType:"Json",
                success: function (data) {
                   document.getElementById("txtid").value = data.id;
                   document.getElementById("txtobservacion").value = data.observacion;
                   document.getElementById("txtPersonalId").value = data.personal_id;
                   document.getElementById("fechaInicio").value = data.dia_hora_inicio;
                   document.getElementById("fechaFin").value = data.dia_hora_fin;
                   document.getElementById("FechaInicioT").value = new Date(data.dia_hora_inicio).toISOString().split('T')[0];
                   document.getElementById("FechaFinT").value = new Date(data.dia_hora_fin).toISOString().split('T')[0];
                   document.getElementById("HoraInicioT").value = new Date(data.dia_hora_inicio).toTimeString().split(' ')[0];
                   document.getElementById("HoraIFinT").value = new Date(data.dia_hora_fin).toTimeString().split(' ')[0];
                   
                   const motivos = data.motivos
                   const miSelect = document.getElementById('sltMotivo');

                   for (let i = 0; i < miSelect.options.length; i++) {
                       miSelect.options[i].selected = false;
                       const findDate = miSelect.options[i].value;
                       const result = motivos.filter(i => i.motivo_id == findDate);
                       if(result.length>0){
                           miSelect.options[i].selected = true;
                       }
                   }
                    
                    //buscarModal.value = data.nombre_completo;
                    llenaHorarioPersonal(data.personal_id, data.nombre_completo, data.area, data.puesto);
                    tittleModalText= document.getElementById("ModalTitle");
                    tittleModalText.textContent="Editar Evento";
                }
            }
            )

            $('#backDropModal').modal('show');

        }
        //no se usa
        function cargarDataEventos() {
            const fechaInicio = $("#dtFechaIni").val();
            const fechaFin = $("#dtFechaFin").val();
            const personal = -1;
            const opcionesFormato = {
                weekday: 'long', // 'long', 'short', 'narrow'
                year: 'numeric',
                month: '2-digit',   // 'numeric', '2-digit', 'long', 'short', 'narrow'
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                hour12: false    // Formato de 24 horas
            };
            const urlListasItemOverTime = "@Url.Action("ListarHorasExtras", "TiempoExtra")?fechaini=" + fechaInicio + "&fechafin=" + fechaFin + "&personal=" + personal;


            $.ajax({
                url: urlListasItemOverTime,
                dataType: "json",
                success: function (data) {
                    document.getElementById("dataTable").querySelector("tbody").innerHTML = "";
                    if (data) {
                        
                        data.forEach(d => {
                            const fIniFormato = (new Date(d.dia_hora_inicio)).toLocaleString('es-PE', opcionesFormato);


                            $("#dataTable tbody").append(
                                $("<tr>").append(
                                    $("<td style='min-width:200px;'>").text(d.nombre_completo),
                                    $("<td style='min-width:200px;'>").text(d.nombre_completo),
                                    $("<td style='min-width:100px;'>").text(d.horario_dia),
                                    $("<td>").text((new Date(d.dia_hora_inicio)).toLocaleString('es-PE', opcionesFormato)),
                                    $("<td>").text((new Date(d.dia_hora_fin)).toLocaleString('es-PE', opcionesFormato)),
                                    $("<td style='text-align:center;'>").text(d.horas_extra),
                                    $("<td style='text-align:center;'>").text(d.minutos_extra),
                                    $("<td style='min-width:250px'>").text(d.motivos),
                                    $("<td style='min-width:250px'>").text(d.observacion),
                                    $("<td>").text((new Date(d.date_add)).toLocaleString('es-PE', opcionesFormato))
                                )
                            )
                        })
                    }
                }
            })
        }
    </script>
}